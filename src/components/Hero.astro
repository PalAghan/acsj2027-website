---
import { u } from '../utils/url';
import { site } from '../data/site';
import Countdown from './Countdown.astro';
const nodes = Array.from({ length: 22 }, (_, i) => ({ x: (i * 137.5) % 100, y: (i * 61.8 + 13) % 100, d: (i % 7) * 0.6 }));
const links = nodes.flatMap((a, i) => nodes.slice(i + 1).filter((b) => Math.hypot(a.x - b.x, a.y - b.y) < 24).map((b) => [a, b]));
---
<section class="hero dark" aria-labelledby="hero-title">
  <svg class="net" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    {links.map(([a, b]) => <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />)}
    {nodes.map((n) => <circle cx={n.x} cy={n.y} r="0.7" style={`animation-delay:${n.d}s`} />)}
  </svg>
  <div class="container inner">
    <div class="copy">
      <h1 id="hero-title"><span class="six">6<sup>th</sup></span> African Conference of <span class="lime">Science Journalists</span></h1>
      <p class="meta"><strong>{site.dates}</strong> <span aria-hidden="true">|</span> {site.location}</p>
      <p class="theme"><span class="eyebrow">Theme</span>{site.theme}</p>
      <div class="actions">
        <a class="btn btn-primary" href={u(site.registerHref)}>Register Now →</a>
        <a class="btn btn-ghost" href="#about">Explore the conference</a>
      </div>
    </div>
    {/* Decorative photos cropped from the banner. Swap for high-res originals when available. */}
    <div class="side">
    <div class="cd-wrap"><p class="cd-label">Conference starts in</p><Countdown /></div>
    <div class="collage" aria-hidden="true">
      <figure class="f woman"><img src={u('/images/photos/woman.jpg')} alt="" width="720" height="800" /></figure>
      <figure class="f sci"><img src={u('/images/photos/scientist.jpg')} alt="" width="440" height="480" /></figure>
      <figure class="f sky"><img src={u('/images/photos/skyline.jpg')} alt="" width="560" height="536" /></figure>
    </div>
    </div>
  </div>
</section>
<style>
  .hero{position:relative;overflow:hidden;background:radial-gradient(120% 90% at 85% 10%,#17754a 0,var(--green-800) 40%,var(--green-950) 100%)}
  .net{position:absolute;inset:0;width:100%;height:100%;opacity:.55}
  .net line{stroke:var(--lime-400);stroke-width:.12;opacity:.35}
  .net circle{fill:var(--lime-400);animation:pulse 4s ease-in-out infinite;transform-box:fill-box;transform-origin:center}
  @keyframes pulse{0%,100%{opacity:.25;transform:scale(1)}50%{opacity:1;transform:scale(1.8)}}
  .inner{position:relative;padding-block:clamp(1.25rem,2.5vw,2rem) clamp(2rem,4vw,3.5rem);display:grid;gap:var(--s6);align-items:center}
  @media(min-width:1000px){.inner{grid-template-columns:1.15fr 1fr}}
  .copy{display:grid;gap:var(--s3)}
  h1{color:var(--white);font-size:clamp(2rem,1rem + 4vw,3.9rem);font-weight:800;max-width:16ch;margin:0}
  .six{color:var(--lime-400);font-size:1.3em}
  .six sup{font-size:.4em;vertical-align:super}
  .lime{color:var(--lime-400)}
  .meta{margin:0;font:700 1.15rem var(--font-display)}
  .theme{margin:0;max-width:46ch;font-size:1.2rem;border-left:4px solid var(--lime-400);padding-left:var(--s2)}
  .theme .eyebrow{display:block}
  .actions{display:flex;flex-wrap:wrap;gap:var(--s2)}
  .btn-ghost{border-color:var(--lime-400);color:var(--white)}
  .btn-ghost:hover{background:rgba(169,209,79,.15)}
  .side{display:grid;gap:var(--s3);justify-items:center}
  .cd-wrap{display:grid;gap:.4rem;justify-items:center}
  .cd-label{margin:0;font:700 .75rem var(--font-display);letter-spacing:.2em;text-transform:uppercase;color:var(--lime-400)}
  @media(min-width:1000px){.side{justify-items:end}.cd-wrap{justify-items:end}}
  .collage{position:relative;aspect-ratio:1/1;width:min(100%,560px);justify-self:center}
  .f{position:absolute;margin:0;animation:float 7s ease-in-out infinite;-webkit-mask-image:radial-gradient(ellipse 75% 75% at 50% 48%,#000 58%,transparent 100%);mask-image:radial-gradient(ellipse 75% 75% at 50% 48%,#000 58%,transparent 100%)}
  .f img{width:100%;height:100%;object-fit:cover;animation:kb 20s ease-in-out infinite alternate}
  .woman{right:0;top:0;width:64%;height:100%;z-index:2}
  .sci{left:0;top:6%;width:46%;height:40%;z-index:1;animation-delay:-2s}
  .sky{left:4%;bottom:0;width:54%;height:46%;z-index:1;animation-delay:-4s}
  .sci img{animation-delay:-6s}.sky img{animation-delay:-11s}
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  @keyframes kb{from{transform:scale(1)}to{transform:scale(1.05)}}
  @media(prefers-reduced-motion:reduce){.net circle{animation:none;opacity:.6}.f,.f img{animation:none}}
</style>
