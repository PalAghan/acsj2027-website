# Copy this file to ".env" (same folder) and fill it in. NEVER share or upload your real .env file.
# The email address that should receive the "new registration" notices:
ORGANISER_EMAIL=you@example.com
# Optional: to send REAL emails (for example through Gmail), fill these in.
# If left empty, emails are saved as files in the demo-outbox folder instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
